# Copia este archivo a .env y rellena con tus llaves reales (NO subir .env al repo)

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key   # solo en servidor (webhooks)

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Correos (Resend) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=Kuki Business <pedidos@kuki.com.mx>
TEAM_EMAIL=ventas@kuki.com.mx

# --- Sitio ---
SITE_URL=https://www.kuki.com.mx

# --- Contacto ---
# En desarrollo: WHATSAPP_PHONE. En hosting (runtime): NUXT_PUBLIC_WHATSAPP_PHONE.
# Formato para wa.me: 52 + 10 dígitos, sin "+" (ej. 529999985969).
WHATSAPP_PHONE=529999985969

# --- Google Analytics 4 ---
# Tu Measurement ID (Admin > Flujos de datos en GA4). Sin esto, GA no carga.
NUXT_PUBLIC_GTAG_ID=G-XXXXXXXXXX
